{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003
        },
        {
            "name": "Launch currently open script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "port": 9003
        },
        {
            "name": "Run Pest Test on Current File",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/vendor/bin/pest",
            "args": [
                "${file}"
            ],
            "cwd": "${workspaceFolder}",
            "port": 9003
        }
    ]
}
