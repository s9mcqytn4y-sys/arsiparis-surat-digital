APP_NAME="Arsiparis Surat Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── University Metadata ──────────────────────────────
UNIVERSITY_NAME="Universitas Digital Nusantara"
UNIVERSITY_CODE="99"
UNIVERSITY_ACCREDITATION="Unggul"

# ─── Database ────────────────────────────────────────
# Option 1: SQLite (default dev / Vercel ephemeral /tmp)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite  ← auto-resolved or copied to /tmp/database.sqlite in serverless

# Option 2: PostgreSQL 16+ (Hostinger VPS / Supabase / Neon Production)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=arsiparis_db
# DB_USERNAME=arsiparis_user
# DB_PASSWORD=secret_password_here
# DB_SSLMODE=prefer
# DATABASE_URL=postgresql://user:password@ep-host.region.aws.neon.tech/arsiparis_db?sslmode=require

# ─── Cache / Queue / Session ─────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Filesystem (Local Protected or S3 / Cloudflare R2) ─
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=arsiparis-documents
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── Mail ────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@universitas.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

