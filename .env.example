APP_NAME="Vibe Starter Engine"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── Database ────────────────────────────────────────
# Option 1: SQLite (default — zero dependency, works instantly)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite  ← auto-resolved

# Option 2: PostgreSQL 16+
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=vibe_starter
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# Option 3: MySQL 8+
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vibe_starter
# DB_USERNAME=root
# DB_PASSWORD=secret

# ─── Cache / Queue / Session ─────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Filesystem ──────────────────────────────────────
FILESYSTEM_DISK=local

# ─── Mail ────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@vibestarter.test"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
