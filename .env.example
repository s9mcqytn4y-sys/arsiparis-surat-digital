APP_NAME="Arsiparis Surat Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── University Metadata ──────────────────────────────
UNIVERSITY_NAME="Universitas Digital Nusantara"
UNIVERSITY_CODE="99"
UNIVERSITY_ACCREDITATION="Unggul"

# ─── Database ────────────────────────────────────────
# Option 1: SQLite (default dev — zero dependency, instant setup)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite  ← auto-resolved

# Option 2: PostgreSQL 16+ (Hostinger VPS Production)
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=arsiparis_db
# DB_USERNAME=arsiparis_user
# DB_PASSWORD=secret_password_here
# DB_SSLMODE=prefer

# ─── Cache / Queue / Session ─────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ─── Filesystem (Hostinger VPS Local Protected Storage) ─
FILESYSTEM_DISK=local

# ─── Mail ────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@universitas.ac.id"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Vite ────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
